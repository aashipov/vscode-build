VSCODE=vscode

COMPOSE_PROJECT_NAME=${VSCODE}

DUMMY_USER=dummy

DOCKER_HUB_USER_AND_REPOSITORY=aashipov/docker

BUILD=build
BUILD_DIR_NAME=${COMPOSE_PROJECT_NAME}-${BUILD}

BUILDBED=${BUILD}bed
BUILDBED_DIR_NAME=${COMPOSE_PROJECT_NAME}-${BUILDBED}

ENTRYPOINT_SH=entrypoint.sh

#ELECTRON_SKIP_BINARY_DOWNLOAD=1
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
NODE_OPTIONS="--max-old-space-size=8192"

NODE_VERSION=24.22.1
TAG_TO_BUILD=1.144.0
